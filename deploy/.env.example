# Copy to .env on the server and fill in. .env is never committed and is not
# overwritten by the deploy workflow.
#
# Generate every secret with:  openssl rand -hex 24
# (hex only: the passwords are embedded in connection URLs).

DOMAIN=aeroflow.example.org
AIRPORT_TIMEZONE=Europe/Chisinau

CORE_APP_SECRET=
PLAYBACK_APP_SECRET=
JWT_PASSPHRASE=

CORE_DB_PASSWORD=
PLAYBACK_DB_PASSWORD=
RABBITMQ_PASSWORD=

# Where core and playback find the databases and the broker. As given, they are
# the postgres and rabbitmq containers of this stack, with the passwords above;
# a managed service goes here instead. RABBITMQ_URL ends with the vhost: each
# transport appends its own queue to it.
CORE_DATABASE_URL=postgresql://aeroflow:${CORE_DB_PASSWORD}@postgres:5432/aeroflow?serverVersion=16&charset=utf8
PLAYBACK_DATABASE_URL=postgresql://playback:${PLAYBACK_DB_PASSWORD}@postgres:5432/aeroflow_playback?serverVersion=16&charset=utf8
RABBITMQ_URL=amqp://aeroflow:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2f
RABBITMQ_MANAGEMENT_URL=http://aeroflow:${RABBITMQ_PASSWORD}@rabbitmq:15672

# Image tags; latest by default. Pin to a commit sha to roll back one service.
# CORE_TAG=latest
# PLAYBACK_TAG=latest
# TTS_TAG=latest
# WEB_TAG=latest
