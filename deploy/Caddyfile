{$DOMAIN} {
	encode zstd gzip

	# Core: the API and the agent's download contract (/internal, the agent's
	# token is checked by core). Every request runs core's front controller in
	# PHP-FPM; REQUEST_URI keeps the original path, so Symfony routing sees it.
	@core path /api/* /internal/*
	handle @core {
		rewrite * /index.php?{query}
		reverse_proxy core-app:9000 {
			transport fastcgi {
				root /var/www/public
				split .php
			}
		}
	}

	# Everything else is the web SPA baked into this image.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
